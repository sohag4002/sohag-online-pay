<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ সার্ভার ও ডিভাইস কনফিগারেশন"
        android:textColor="@color/text_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="ড্যাশবোর্ডের Credentials ম্যানুয়ালি প্রবেশ করান"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Server URL -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="সার্ভার URL (e.g. https://domain.com)"
        app:boxStrokeColor="@color/primary_navy">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Merchant Email -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="মার্চেন্ট ইমেইল (User Email)"
        app:boxStrokeColor="@color/primary_navy">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUserEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Device Key -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="ডিভাইস কী (Device Key - 40 Chars)"
        app:boxStrokeColor="@color/primary_navy">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDeviceKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="বাতিল"
            android:textColor="@color/primary_navy"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_white"
            app:strokeColor="@color/primary_navy"
            app:strokeWidth="1.5dp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="সংরক্ষণ করুন"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_red"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
